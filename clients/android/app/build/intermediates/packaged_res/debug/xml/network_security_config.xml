<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 本地 WebView 以 file:// 加载，无需联网；放开 cleartext 以防个别内嵌资源 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
